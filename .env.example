# =============================================================================
# FLOW NETWORK CONFIGURATION (PRIMARY)
# =============================================================================

# Flow Network: 'testnet' or 'mainnet'
FLOW_NETWORK=testnet

# Flow Access Node (Testnet)
NEXT_PUBLIC_TESTNET_ACCESS_NODE=https://access-testnet.onflow.org

# Flow Discovery Wallet (Testnet)
NEXT_PUBLIC_TESTNET_DISCOVERY_WALLET=https://fcl-discovery.onflow.org/testnet/authn

# Flow Access Node (Mainnet)
NEXT_PUBLIC_MAINNET_ACCESS_NODE=https://access-mainnet.onflow.org

# Flow Treasury (Public address where FLOW deposits are received)
NEXT_PUBLIC_FLOW_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Flow Treasury private key (Backend only - secure this! Hex-encoded secp256k1 key)
FLOW_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
FLOW_TREASURY_PRIVATE_KEY=your-flow-treasury-private-key-hex

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

NEXT_PUBLIC_APP_NAME=Flownomo
NEXT_PUBLIC_ROUND_DURATION=30
NEXT_PUBLIC_PRICE_UPDATE_INTERVAL=1000
NEXT_PUBLIC_CHART_TIME_WINDOW=300000

# WalletConnect Project ID (used for legacy chain modals if any)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
