# =============================================================================
# FLOW NETWORK CONFIGURATION
# =============================================================================

# Flow Network: testnet
NEXT_PUBLIC_FLOW_NETWORK=testnet

# Flow Access Node (Testnet)
NEXT_PUBLIC_TESTNET_ACCESS_NODE=https://rest-testnet.onflow.org

# Flow Discovery Wallet (Testnet)
NEXT_PUBLIC_TESTNET_DISCOVERY_WALLET=https://fcl-discovery.onflow.org/testnet/authn

# Flow Treasury (Public address where FLOW deposits are received)
NEXT_PUBLIC_FLOW_TREASURY_ADDRESS=0xfc2730bbe0bd4941

# Flow Treasury private key (Backend only - secure this! Hex-encoded secp256k1 key)
FLOW_TREASURY_ADDRESS=0xfc2730bbe0bd4941
FLOW_TREASURY_PRIVATE_KEY=your-flow-treasury-private-key-hex

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

NEXT_PUBLIC_APP_NAME=Flownomo
NEXT_PUBLIC_ROUND_DURATION=30
NEXT_PUBLIC_PRICE_UPDATE_INTERVAL=1000
NEXT_PUBLIC_CHART_TIME_WINDOW=300000
